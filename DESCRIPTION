Package: robustICP
Type: Package
Title: Robust Individual Conformal Prediction for Multilevel Functional Data
Version: 1.0.0
Authors@R:
    c(
      person("Holger", "Cevallos-Valdiviezo",
             email = "holgceva@espol.edu.ec",
